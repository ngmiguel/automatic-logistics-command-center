# Application
APP_NAME=Automatic Logistics Command Center
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://alcc:alcc_secret@localhost:5432/alcc_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Simulator
SIMULATOR_VEHICLE_COUNT=1000
SIMULATOR_TICK_INTERVAL_SECONDS=1.0
SIMULATOR_INCIDENT_RATE=0.001
SIMULATOR_FUEL_CONSUMPTION_RATE=0.05

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://localhost:8081"]
